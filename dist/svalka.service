[Unit]
Description=svalka fan control
Documentation=https://github.com/tinnet/svalka
After=systemd-modules-load.service
# If another fan-control service may be installed, add Conflicts=<its unit>:
# two daemons writing the same PWM outputs fight over them.

[Service]
Type=notify
ExecStart=/usr/local/bin/svalka run
ExecReload=/bin/kill -HUP $MAINPID
# Runs after every stop, including SIGKILL and panics: hands the fans back
# to the chip's own curve.
ExecStopPost=/usr/local/bin/svalka restore
WatchdogSec=10s
Restart=on-failure
RestartSec=2s
RuntimeDirectory=svalka
RuntimeDirectoryMode=0755

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
MemoryDenyWriteExecute=yes
# Deliberately not ProtectKernelTunables=: it makes /sys read-only, and the
# fans are controlled through /sys.

[Install]
WantedBy=multi-user.target
